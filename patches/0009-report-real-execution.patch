diff --git a/report/wii_esc/wii_report.aux b/report/wii_esc/wii_report.aux
new file mode 100644
index 0000000..db8cc35
--- /dev/null
+++ b/report/wii_esc/wii_report.aux
@@ -0,0 +1,38 @@
+\relax 
+\providecommand\hyper@newdestlabel[2]{}
+\providecommand\HyField@AuxAddToFields[1]{}
+\providecommand\HyField@AuxAddToCoFields[2]{}
+\@writefile{toc}{\contentsline {section}{\numberline {1}Setup}{1}{section.1}\protected@file@percent }
+\@writefile{toc}{\contentsline {section}{\numberline {2}Results}{2}{section.2}\protected@file@percent }
+\@writefile{toc}{\contentsline {subsection}{\numberline {2.1}Quality against call budget}{2}{subsection.2.1}\protected@file@percent }
+\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Improvement (left) and what-if calls actually used (right) for $K=20$. Wii (alpha 0.9) always needs the same number of calls (429 in this draw, 429--437 over four draws) and wii+coverage about 149, so their curves are flat; the baseline is limited by the budget. Figures show the first statistics draw.}}{2}{figure.caption.1}\protected@file@percent }
+\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
+\newlabel{fig:budget}{{1}{2}{Improvement (left) and what-if calls actually used (right) for $K=20$. Wii (alpha 0.9) always needs the same number of calls (429 in this draw, 429--437 over four draws) and wii+coverage about 149, so their curves are flat; the baseline is limited by the budget. Figures show the first statistics draw}{figure.caption.1}{}}
+\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces TPC-H SF10, $K=20$, means over four statistics draws. Ranges over the draws: baseline 25.48--25.62, 28.83--29.97, 33.33--34.50 and 33.39--34.58\%; Wii 32.18--33.29\%; coverage 30.80--31.70\%. For $K=10$ the Wii rows are identical and the baseline gives 25.57, 29.37, 33.23 and 33.52\% (2\,723 calls at $B=5000$).}}{2}{table.caption.2}\protected@file@percent }
+\newlabel{tab:main}{{1}{2}{TPC-H SF10, $K=20$, means over four statistics draws. Ranges over the draws: baseline 25.48--25.62, 28.83--29.97, 33.33--34.50 and 33.39--34.58\%; Wii 32.18--33.29\%; coverage 30.80--31.70\%. For $K=10$ the Wii rows are identical and the baseline gives 25.57, 29.37, 33.23 and 33.52\% (2\,723 calls at $B=5000$)}{table.caption.2}{}}
+\@writefile{toc}{\contentsline {subsection}{\numberline {2.2}The role of alpha}{3}{subsection.2.2}\protected@file@percent }
+\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Left: higher $\alpha $ skips fewer calls and gives better indexes. Right: random skipping at probability 0.9 with three seeds, against Wii.}}{3}{figure.caption.3}\protected@file@percent }
+\newlabel{fig:alpha}{{2}{3}{Left: higher $\alpha $ skips fewer calls and gives better indexes. Right: random skipping at probability 0.9 with three seeds, against Wii}{figure.caption.3}{}}
+\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Alpha sweep ($K=20$, $B=1000$), means over four draws (spread 0.5--1.2 points, up to 3 points for coverage at $\alpha =0.5$); the unlimited baseline reaches 33.95\% with about 3\,036 calls.}}{3}{table.caption.4}\protected@file@percent }
+\newlabel{tab:alpha}{{2}{3}{Alpha sweep ($K=20$, $B=1000$), means over four draws (spread 0.5--1.2 points, up to 3 points for coverage at $\alpha =0.5$); the unlimited baseline reaches 33.95\% with about 3\,036 calls}{table.caption.4}{}}
+\@writefile{toc}{\contentsline {subsection}{\numberline {2.3}Why skipping is safe: derived against real costs}{3}{subsection.2.3}\protected@file@percent }
+\@writefile{toc}{\contentsline {subsection}{\numberline {2.4}Assumptions of the cost model}{3}{subsection.2.4}\protected@file@percent }
+\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces For every real what-if call of a budgeted baseline run ($K=20$, $B=1000$), the error the derived cost would have had.}}{4}{figure.caption.5}\protected@file@percent }
+\newlabel{fig:gaps}{{3}{4}{For every real what-if call of a budgeted baseline run ($K=20$, $B=1000$), the error the derived cost would have had}{figure.caption.5}{}}
+\@writefile{toc}{\contentsline {section}{\numberline {3}Esc: early stopping}{4}{section.3}\protected@file@percent }
+\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Esc on TPC-H SF10: calls saved and improvement lost relative to the same run that never stops (about 3\,000 calls without Wii and 430 with Wii at $K=20$). Ranges are over independent statistics draws (three for plain Esc-B, two for the clamped variants; no-index cost 42.59--42.69M).}}{4}{table.caption.6}\protected@file@percent }
+\newlabel{tab:esc}{{3}{4}{Esc on TPC-H SF10: calls saved and improvement lost relative to the same run that never stops (about 3\,000 calls without Wii and 430 with Wii at $K=20$). Ranges are over independent statistics draws (three for plain Esc-B, two for the clamped variants; no-index cost 42.59--42.69M)}{table.caption.6}{}}
+\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}Storage-limited setting}{5}{subsection.3.1}\protected@file@percent }
+\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Esc-B ($\epsilon =5\%$) under storage budgets ($K=100$), TPC-H SF10, means over three repetitions. Cost is the relative workload cost. ``Stopped'': repetitions in which Esc stopped before the search ended. A negative saving at 2.5 and 3\,GB is the 19 extra calls Esc needs for the all-candidates costs.}}{5}{table.caption.7}\protected@file@percent }
+\newlabel{tab:escstorage}{{4}{5}{Esc-B ($\epsilon =5\%$) under storage budgets ($K=100$), TPC-H SF10, means over three repetitions. Cost is the relative workload cost. ``Stopped'': repetitions in which Esc stopped before the search ended. A negative saving at 2.5 and 3\,GB is the 19 extra calls Esc needs for the all-candidates costs}{table.caption.7}{}}
+\@writefile{toc}{\contentsline {section}{\numberline {4}Comparison with the eight algorithms of the original study}{6}{section.4}\protected@file@percent }
+\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Relative workload cost (\%, lower is better) at 5, 10 and 15\,GB storage budgets, and what-if calls and algorithm runtime at 10\,GB. The last block has no storage budget: AutoAdmin and Drop at $K=10$ indexes, Dexter at a 10\% saving threshold.}}{6}{table.caption.8}\protected@file@percent }
+\newlabel{tab:compare}{{5}{6}{Relative workload cost (\%, lower is better) at 5, 10 and 15\,GB storage budgets, and what-if calls and algorithm runtime at 10\,GB. The last block has no storage budget: AutoAdmin and Drop at $K=10$ indexes, Dexter at a 10\% saving threshold}{table.caption.8}{}}
+\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Relative workload cost (left, from 1.5\,GB) and what-if calls (right) against the storage budget. Dashed: Wii and Esc on top of the two-phase tuner; Wii~+~Esc coincides with Wii.}}{7}{figure.caption.9}\protected@file@percent }
+\newlabel{fig:compare}{{4}{7}{Relative workload cost (left, from 1.5\,GB) and what-if calls (right) against the storage budget. Dashed: Wii and Esc on top of the two-phase tuner; Wii~+~Esc coincides with Wii}{figure.caption.9}{}}
+\@writefile{toc}{\contentsline {section}{\numberline {5}Real execution}{7}{section.5}\protected@file@percent }
+\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces Improvement of the workload runtime over no indexes (positive is faster), estimated against measured, at 5\,GB.}}{7}{table.caption.10}\protected@file@percent }
+\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Estimated against measured improvement; the dashed line is agreement.}}{8}{figure.caption.11}\protected@file@percent }
+\@writefile{toc}{\contentsline {section}{\numberline {6}Discussion and limitations}{8}{section.6}\protected@file@percent }
+\@writefile{toc}{\contentsline {section}{\numberline {7}Status and next steps}{9}{section.7}\protected@file@percent }
+\gdef \@abspage@last{9}
