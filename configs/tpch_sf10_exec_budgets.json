{
    "database_system": "postgres",
    "benchmark_name": "tpch",
    "scale_factor": 10,
    "algorithms": [
        {
            "name": "cophy",
            "parameters": {
                "budget_MB": [
                    2500,
                    5000
                ],
                "max_index_width": 3,
                "max_indexes_per_query": 1,
                "solver": "highs"
            },
            "timeout": 300
        },
        {
            "name": "db2advis",
            "parameters": {
                "max_index_width": 2,
                "budget_MB": [
                    2500,
                    5000
                ],
                "try_variations_seconds": 0
            },
            "timeout": 300
        },
        {
            "name": "two_phase_greedy",
            "parameters": {
                "budget_MB": [
                    2500,
                    5000
                ],
                "max_indexes": 100,
                "interception": "none"
            },
            "timeout": 300
        },
        {
            "name": "two_phase_greedy",
            "parameters": {
                "budget_MB": [
                    2500,
                    5000
                ],
                "max_indexes": 100,
                "interception": "wii",
                "alpha": 0.9
            },
            "timeout": 300
        },
        {
            "name": "gadis",
            "parameters": {
                "budget_MB": [
                    2500,
                    5000
                ],
                "max_index_width": 1
            },
            "timeout": 300
        },
        {
            "name": "gadis",
            "parameters": {
                "budget_MB": [
                    2500,
                    5000
                ],
                "max_index_width": 2
            },
            "timeout": 300
        }
    ],
    "queries": [
        1,
