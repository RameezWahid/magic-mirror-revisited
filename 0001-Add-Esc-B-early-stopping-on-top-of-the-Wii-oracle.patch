diff --git a/selection/esc.py b/selection/esc.py
new file mode 100644
index 0000000..e1deab7
--- /dev/null
+++ b/selection/esc.py
@@ -0,0 +1,111 @@
+import logging
+import time
+
+
+class EarlyStoppingChecker:
+    """Esc-B: early-stopping checker for budget-aware index tuning (Wang et al.,
+    "Esc: An Early-Stopping Checker for Budget-aware Index Tuning", PVLDB 2025).
+
+    The tuner may stop at what-if call t if
+        eta_U(final best) - eta_L(best at t) <= epsilon,
+    where eta is the percentage improvement 1 - cost(W, C) / cost(W, empty).
+
+    eta_L (what we already have for sure): simulated greedy search that finishes
+        the selection with derived costs only (no what-if calls). Derived costs
+        are upper bounds of the real cost, so this improvement is a lower bound.
+    eta_U (the most any final configuration could reach): the K indexes with the
+        largest workload-level MCI upper bound u(W, z) = sum_q u(q, z); the cost
+        cannot drop by more than their sum (Eq. 10 of the paper).
+
+    Only the variant without index interaction (Esc-B) is implemented.
+    Checked at the start of every greedy step of Phase 2 of two-phase greedy.
+    """
+
+    def __init__(self, oracle, max_indexes, epsilon=0.05, clamp_omega=False):
+        self.oracle = oracle
+        self.max_indexes = max_indexes
+        self.epsilon = epsilon
+        # Optional, not in the paper: the workload cannot cost less than the sum
+        # of the per-query costs with all candidates at once (Omega), so the
+        # upper bound on the improvement is capped there.
+        self.clamp_omega = clamp_omega
+        self.trace = []  # (calls, selected so far, eta_L, eta_U)
+        self.checks = 0
+        self.time = 0.0
+        self.stopped_at_calls = None
+
+    # Lower bound on the improvement of the best configuration at this point.
+    def simulated_greedy(self, selected, candidates):
+        oracle = self.oracle
+        queries = oracle.workload.queries
+        configuration = frozenset(selected)
+        per_query = {
+            q: oracle.derived_cost(q, oracle.relevant(q, configuration))
+            for q in queries
+        }
+        affected = {
+            z: [q for q in queries if oracle.relevant(q, [z])] for z in candidates
+        }
+        while len(configuration) < self.max_indexes:
+            best, best_gain, best_costs = None, 0.0, None
+            for z in candidates:
+                if z in configuration:
+                    continue
+                trial = configuration | {z}
+                costs = {
+                    q: oracle.derived_cost(q, oracle.relevant(q, trial))
+                    for q in affected[z]
+                }
+                gain = sum(per_query[q] - costs[q] for q in affected[z])
+                if gain > best_gain:
+                    best, best_gain, best_costs = z, gain, costs
+            if best is None:
+                break
+            configuration = configuration | {best}
+            per_query.update(best_costs)
+        return configuration, sum(per_query.values())
+
+    # Upper bound on the improvement of the final best configuration.
+    def improvement_upper_bound(self, candidates):
+        oracle = self.oracle
+        queries = oracle.workload.queries
+        empty = sum(oracle.empty_cost[q] for q in queries)
+        saving = {}
+        for z in candidates:
+            total = 0.0
+            for q in queries:
+                if oracle.relevant(q, [z]):
+                    bound = max(0.0, oracle.mci_bound(q, z))
+                    total += bound
+            saving[z] = total
+        top = sorted(candidates, key=lambda z: (-saving[z], z))[: self.max_indexes]
+        top = [z for z in top if saving[z] > 0]
+        # Eq. 10: the K largest workload-level bounds, summed. No per-query floor:
+        # with floors, picking the K largest sums would no longer be the best case.
+        lower_cost = max(0.0, empty - sum(saving[z] for z in top))
+        if self.clamp_omega:
+            # Every query costs at least c(q, Omega_q), whatever is selected.
+            lower_cost = max(
+                lower_cost, sum(oracle.omega_cost.get(q, 0.0) for q in queries)
+            )
+        return 1 - lower_cost / empty
+
+    def check(self, selected, candidates):
+        """Returns the configuration to stop with, or None to keep tuning."""
+        start = time.time()
+        oracle = self.oracle
+        empty = sum(oracle.empty_cost.values())
+        configuration, derived_cost = self.simulated_greedy(selected, candidates)
+        eta_lower = 1 - derived_cost / empty
+        eta_upper = self.improvement_upper_bound(candidates)
+        self.checks += 1
+        self.trace.append((oracle.calls, len(selected), eta_lower, eta_upper))
+        self.time += time.time() - start
+        if eta_upper - eta_lower <= self.epsilon:
+            self.stopped_at_calls = oracle.calls
+            logging.info(
+                f"Esc: stop at {oracle.calls} calls, "
+                f"eta_L={eta_lower:.4f}, eta_U={eta_upper:.4f}"
+            )
+            return configuration
+        return None
diff --git a/tests/test_esc.py b/tests/test_esc.py
new file mode 100644
index 0000000..0217f24
--- /dev/null
+++ b/tests/test_esc.py
@@ -0,0 +1,128 @@
+import random
+import unittest
+
+from selection.budget_aware import BudgetAwareCostOracle, TwoPhaseGreedy
+from selection.esc import EarlyStoppingChecker
+from selection.index import Index
+from selection.workload import Query, Workload
+
+
+class Table:
+    def __init__(self, name):
+        self.name = name
+
+    def __hash__(self):
+        return hash(self.name)
+
+    def __eq__(self, other):
+        return self.name == other.name
+
+    def __lt__(self, other):
+        return self.name < other.name
+
+
+class Column:
+    def __init__(self, table, name):
+        self.table, self.name = table, name
+
+    def __hash__(self):
+        return hash((self.table.name, self.name))
+
+    def __eq__(self, other):
+        return (self.table.name, self.name) == (other.table.name, other.name)
+
+    def __lt__(self, other):
+        return (self.table.name, self.name) < (other.table.name, other.name)
+
+    def __repr__(self):
+        return f"{self.table.name}.{self.name}"
+
+
+class SyntheticCosts:
+    """Monotone, submodular what-if cost: every covered leading column multiplies
+    the query's cost by (1 - benefit)."""
+
+    def __init__(self, benefit, base):
+        self.benefit, self.base = benefit, base
+
+    def cost(self, query, configuration):
+        covered = {}
+        for index in configuration:
+            lead = index.columns[0]
+            if lead in query.columns:
+                covered[lead] = max(covered.get(lead, 0), self.benefit[(query.nr, lead)])
+        cost = self.base[query.nr]
+        for benefit in covered.values():
+            cost *= 1 - benefit
+        return cost
+
+    def calculate_cost(self, workload, configuration, store_size=False):
+        return sum(self.cost(q, configuration) for q in workload.queries)
+
+    def which_indexes_utilized_and_cost(self, query, configuration):
+        return set(configuration), self.cost(query, configuration)
+
+
+def build(seed, queries=12, tables=4, columns=5):
+    rng = random.Random(seed)
+    cols = [Column(Table(f"t{t}"), f"c{c}") for t in range(tables) for c in range(columns)]
+    qs = [Query(i, "q", rng.sample(cols, rng.randint(3, 7))) for i in range(queries)]
+    benefit = {(q.nr, c): rng.uniform(0.02, 0.5) for q in qs for c in q.columns}
+    base = {q.nr: rng.uniform(1e3, 1e5) for q in qs}
+    candidates = [
+        [Index((c,)) for c in q.columns]
+        + [Index((a, b)) for a in q.columns for b in q.columns
+           if a != b and a.table == b.table]
+        for q in qs
+    ]
+    return qs, SyntheticCosts(benefit, base), base, candidates
+
+
+def run(seed, interception, epsilon=None, budget=None, k=5):
+    qs, costs, base, candidates = build(seed)
+    oracle = BudgetAwareCostOracle(
+        costs, Workload(qs), budget=budget, interception=interception,
+        need_omega=epsilon is not None,
+    )
+    oracle.candidate_counts = {}
+    oracle.initialize(candidates)
+    search = TwoPhaseGreedy(oracle, candidates, k)
+    if epsilon is not None:
+        search.checker = EarlyStoppingChecker(oracle, k, epsilon=epsilon)
+    selected = search.run()
+    improvement = 1 - sum(costs.cost(q, selected) for q in qs) / sum(base.values())
+    return improvement, oracle, search
+
+
+class TestEsc(unittest.TestCase):
+    def test_loss_never_exceeds_epsilon(self):
+        for seed in range(15):
+            reference, _, _ = run(seed, "none")
+            for epsilon in (0.01, 0.05, 0.10):
+                improvement, _, _ = run(seed, "none", epsilon)
+                self.assertLessEqual(reference - improvement, epsilon + 1e-9)
+
+    def test_upper_bound_never_below_final_improvement(self):
+        for seed in range(15):
+            reference, _, _ = run(seed, "none")
+            _, _, search = run(seed, "none", 0.05)
+            for _, _, lower, upper in search.checker.trace:
+                self.assertGreaterEqual(upper, reference - 1e-9)
+                self.assertGreaterEqual(upper, lower - 1e-9)
+
+    def test_never_stops_with_negative_epsilon(self):
+        _, _, search = run(3, "none", -1.0)
+        self.assertFalse(search.stopped_early)
+
+    def test_stops_with_large_epsilon(self):
+        _, oracle, search = run(3, "none", 1.0)
+        self.assertTrue(search.stopped_early)
+        self.assertEqual(search.checker.stopped_at_calls, oracle.calls)
+
+    def test_budget_respected_with_esc(self):
+        _, oracle, _ = run(2, "wii", 0.05, budget=150)
+        self.assertLessEqual(oracle.calls, 150)
+
+
+if __name__ == "__main__":
+    unittest.main()
